---
// Tracks clicks on "try next" recommendation links on the progress page
---
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-recommendation]').forEach(function (link) {
      link.addEventListener('click', function () {
        window.posthog?.capture('recommendation_clicked', {
          product: link.getAttribute('data-recommendation'),
        });
      });
    });
  });
</script>
